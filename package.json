{
  "name": "cloudflare-website-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev --env production",
    "preview:staging": "npm run build && wrangler dev --env staging",
    "test": "vitest run",
    "check:worker": "tsc -p worker/tsconfig.json && tsc -p scripts/jsconfig.json",
    "setup": "node scripts/setup.mjs",
    "publish:staging": "node scripts/publish.mjs staging",
    "publish:production": "node scripts/publish.mjs production",
    "types": "wrangler types worker/worker-configuration.d.ts --include-env=false"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/node": "26.6.5",
    "astro": "7.4.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
